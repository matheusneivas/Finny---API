# Copie para .env (que NÃO vai para o git) e preencha. Em produção, configure no provedor de hospedagem.

# Perfil: deixe vazio em produção. Use "dev" para rodar localmente com H2 em memória.
SPRING_PROFILES_ACTIVE=dev

# Banco (produção)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finny_db
DB_USERNAME=finny
DB_PASSWORD=
# Ex.: ?sslmode=require em bancos gerenciados
DB_URL_PARAMS=

# Segredos (obrigatórios em produção). Gere com: openssl rand -base64 48
JWT_SECRET=
INTERNAL_API_KEY=
CPF_SECRET=

# IA (Claude por padrão)
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
AI_API_KEY=
AI_EFFORT=low
AI_MAX_TOKENS=4096

# Limites do chat (mensagens enviadas pelo usuário por mês)
CHAT_FREE_MONTHLY_LIMIT=100
CHAT_PREMIUM_MONTHLY_LIMIT=1000
APP_TIMEZONE=America/Sao_Paulo

# Web (o app mobile não precisa de CORS). Separe por vírgula.
CORS_ALLOWED_ORIGINS=

# Atrás de proxy/load balancer: framework
FORWARD_HEADERS_STRATEGY=none

# Swagger UI em /swagger-ui.html (deixe false em produção)
API_DOCS_ENABLED=false

# Push (opcional): caminho do JSON da conta de serviço do Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=
